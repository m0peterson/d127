# Для локального запуска через `npx netlify-cli dev`: скопируй файл в .env и впиши свои значения.
# .env в git не попадает. На Netlify те же три переменные задаются в настройках сайта, см. README.

# openrouter | opencodego | mock
# mock не ходит в сеть и ключа не просит: отдаёт случайную цитату из сборника, годится для проверки проводки.
LLM_PROVIDER=mock

# Ключ провайдера. Для mock не нужен.
LLM_API_KEY=

# Id модели. Для openrouter вида автор/модель, для opencodego просто id. Для mock не нужен.
LLM_MODEL=
