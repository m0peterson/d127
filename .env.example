# Для локального запуска через `npx netlify-cli dev`: скопируй файл в .env и впиши свои значения.
# .env в git не попадает. На Netlify переменные задаются в настройках сайта, см. README.

# openrouter | opencodego | mock
# mock без личного ключа не ходит в сеть: отдаёт случайную цитату из сборника.
# Свой ключ в приложении включает OpenRouter даже при LLM_PROVIDER=mock.
# Новый интерфейс с выбором модели работает через OpenRouter.
LLM_PROVIDER=mock

# Серверный ключ OpenRouter: используется, если поле личного ключа в приложении пустое.
# Для mock без личного ключа не нужен. Не добавляй настоящий ключ в репозиторий.
LLM_API_KEY=

# Только для прежних API-клиентов OpenCode Go без model и apiKey в запросе.
# OpenRouter игнорирует LLM_MODEL: модель выбирается в интерфейсе,
# по умолчанию meta/muse-spark-1.3-contributor (high, если поддерживается),
# затем xiaomi/mimo-v2.6-pro (high) и anthropic/claude-haiku-5.5 (xhigh).
LLM_MODEL=
